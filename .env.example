# --- WhatsApp Cloud API credentials (Meta → your App → WhatsApp) ---

# Permanent access token (System User token recommended for production).
WHATSAPP_TOKEN=

# The phone number ID of your WhatsApp Business number (NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# Your Meta App Secret (App → Settings → Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# A random string you choose. You enter the SAME value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=

# Graph API version. Bump when Meta releases a new one.
WHATSAPP_API_VERSION=v22.0

# Optional: a published WhatsApp Flow id (WhatsApp Manager → Flows). When set,
# the bot uses a single native multi-select FORM instead of the step chat.
# See FLOWS.md. Leave blank for the step-by-step conversational flow.
WHATSAPP_FLOW_ID=

# --- Server ---
PORT=3000

# --- Conversation state storage ---
# STORAGE=memory | supabase   (defaults to memory)
# Use "supabase" on serverless hosts (Vercel/Workers) so state survives across
# invocations. "memory" is fine for a long-running server (Railway/Fly/Render).
STORAGE=memory

# Supabase creds. Required when STORAGE=supabase, AND — when present — they also
# enable the unified CRM: completed leads are inserted into CRM_LEADS_TABLE
# (the same `leads` table the website uses), so they show up in /admin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Table completed leads land in (unified CRM). Defaults to "leads".
CRM_LEADS_TABLE=leads

# --- Flow config (used by the bundled Fennr flow) ---
CALENDLY_URL=https://calendly.com/fennrstudio/15min
PORTFOLIO_URL=https://www.fennrstudio.com
